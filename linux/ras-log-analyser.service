[Unit]
Description=RAS upload-only log analyser
After=network.target

[Service]
Type=simple
User=ras-log-analyser
Group=ras-log-analyser
WorkingDirectory=/opt/ras-log-analyser/current
ExecStart=/opt/ras-log-analyser/current/.venv/bin/python /opt/ras-log-analyser/current/production.py --config /var/lib/ras-log-analyser/appsettings.json --host 127.0.0.1 --port 8766
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/ras-log-analyser /var/log/ras-log-analyser

[Install]
WantedBy=multi-user.target
