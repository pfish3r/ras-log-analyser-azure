{
  "Database": "data/issues.sqlite3",
  "LocalLog": "data/analyser.log",
  "ErrorSearchStrings": [
    "error",
    "exception",
    "fatal"
  ],
  "ParseRules": [
    {
      "Kind": "login_failed",
      "Pattern": "(?P<timestamp>\\d{2}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}) - Logon failed user '(?P<user>[^']+)' client IP '(?P<ip>[^']+)'"
    },
    {
      "Kind": "login_failed",
      "Pattern": "\\b(?:Logon|Login) failed\\b.*?user '(?P<user>[^']+)'"
    },
    {
      "Kind": "login",
      "Pattern": "\\b(?:Logon|Login) successful user '(?P<user>[^']+)'(?: client IP '(?P<ip>[^']+)')?(?: host '(?P<host>[^']+)')?"
    },
    {
      "Kind": "connection",
      "Pattern": "\\bUser '(?P<user>[^']+)' connected to host '(?P<host>[^']+)'"
    },
    {
      "Kind": "logout",
      "Pattern": "\\bUser '(?P<user>[^']+)' logged out(?: from host '(?P<host>[^']+)')?"
    }
  ]
}
